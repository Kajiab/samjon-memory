# samjon-memory - Docker deployment configuration.
#
# Copy this file to `.env` next to compose.yaml and set real values:
#   powershell -ExecutionPolicy Bypass -File .\scripts\docker-up.ps1
#   (or: docker compose up -d --build)
#
# Docker Compose automatically reads `.env` from the project directory for
# variable interpolation, so the values below flow into the container.
# Never commit the real `.env`.
#
# ---------------------------------------------------------------------------
# Container layout (fixed - do not change)
# ---------------------------------------------------------------------------
SAMJON_CORE_DATABASE_PATH=/app/data/samjon_core.sqlite
SAMJON_RESOLVER_DATABASE_PATH=/app/data/samjon_resolver.sqlite
SAMJON_MEDIA_ROOT=/app/data/media
SAMJON_CORE_HOST=0.0.0.0
SAMJON_CORE_PORT=8100

# ---------------------------------------------------------------------------
# API tokens - leave empty to keep API endpoints unauthenticated (local only).
# Set strong random values for a production-like deployment.
# ---------------------------------------------------------------------------
SAMJON_CORE_SERVICE_TOKEN=
SAMJON_CORE_ADMIN_TOKEN=
SAMJON_CORE_READ_TOKEN=

# ---------------------------------------------------------------------------
# Portal credentials (exactly one household administrator) - REQUIRED for the
# Portal UI. HTTP Basic. No safe default; generate a strong password.
# ---------------------------------------------------------------------------
SAMJON_PORTAL_USERNAME=
SAMJON_PORTAL_PASSWORD=

# ---------------------------------------------------------------------------
# Allowed Origins (exact scheme + host + port, comma-separated)
# ---------------------------------------------------------------------------
SAMJON_PORTAL_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# ---------------------------------------------------------------------------
# Core behaviour
# ---------------------------------------------------------------------------
SAMJON_CORE_ENV=production
SAMJON_CORE_CORS_ORIGINS=*
SAMJON_CORE_PORTAL_ENABLED=true
SAMJON_CORE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Resolver
# ---------------------------------------------------------------------------
SAMJON_RESOLVER_FTS5_REQUIRED=true

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------
SAMJON_LIFECYCLE_AUTOMATIC_PURGE_ENABLED=false
SAMJON_LIFECYCLE_PURGE_MIN_AGE_DAYS=30

# ---------------------------------------------------------------------------
# Media limits (optional overrides)
# ---------------------------------------------------------------------------
SAMJON_MEDIA_MAX_UPLOAD_BYTES=10485760
SAMJON_MEDIA_MAX_WIDTH=8192
SAMJON_MEDIA_MAX_HEIGHT=8192
SAMJON_MEDIA_THUMB_WIDTH=400
SAMJON_MEDIA_THUMB_HEIGHT=400
SAMJON_MEDIA_MAX_PER_ENTITY=20
SAMJON_MEDIA_MAX_ALT_TEXT=500
SAMJON_MEDIA_MAX_CAPTION=2000